# ==============================================================================
# Research & Data Artifacts
# ==============================================================================
# Large raw/processed datasets (downloaded or regenerated by reproduction scripts)
data/raw/
data/processed/
data/cache/

# Large prediction CSVs (compressed .csv.gz archives are tracked in git)
results/predictions/*.csv

# Transient experiment and execution logs
logs/*.log

# ==============================================================================
# Python Build, Cache & Environment
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Packages & distributions
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing, type checking & code quality caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ==============================================================================
# Editor, IDE & OS Files
# ==============================================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
scratch/

